# Dependencies
node_modules/

# Build output
dist/
web/dist/

# Local DynamoDB exports
exports/

.superpowers/
superpowers/

# Lambda artifact
lambda.zip

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
# Deployment-specific values (account ids, ARNs, domains) — never commit
*.tfvars
!*.tfvars.example

# Environment
.env
.env.*

# Selfhost runtime data (bind-mounted; never commit)
config/

# OS
.DS_Store

# Smart deploy hash cache
.api-build-hash

# Git worktrees (local dev isolation)
.worktrees/

# Security audits of the live deployment (local only; publishing them maps
# the prod attack surface). Plans/specs describing shipped fixes stay tracked.
audits/

# AI tooling scratch/cache dirs
.gemini_security/
.superpowers/
.understand-anything/
.claude/

# Generated by docs-site/scripts/sync-release-info.mjs at build time
docs-site/src/content/docs/self-hosting/release-notes.md

# Normalise line endings so a clone on Windows doesn't produce a diff in every
# file, and keep shell scripts LF regardless of platform — CRLF breaks the
# shebang inside the container.
* text=auto eol=lf

*.sh text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated or vendored — collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff
uv.lock linguist-generated=true -diff
CHANGELOG.md linguist-generated=true

# Planning artifacts are documentation, not source; keep them out of the
# repository's language breakdown.
superpowers/** linguist-documentation=true
docs-site/** linguist-documentation=true
